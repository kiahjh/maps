{
  "name": "lilith-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "python3 scripts/prepare-map-data.py",
    "predev": "npm run data",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run data && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "assets": "node --experimental-strip-types scripts/assets/export-models.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
